<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://www.salesforce.com/2006/04/metadata">
    <fullName>Amount_Greater_Than_Zero</fullName>
    <active>true</active>
    <description>Claim amount must be greater than zero</description>
    <errorConditionFormula>ISBLANK(Amount__c) || Amount__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>Amount__c</errorDisplayField>
    <errorMessage>Claim amount must be greater than zero</errorMessage>
</ValidationRule>
