<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://www.salesforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Validates geo-fence and spawns activities on Visit check-in</description>
