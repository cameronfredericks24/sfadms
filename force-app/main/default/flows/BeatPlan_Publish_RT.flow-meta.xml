<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://www.salesforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Creates BeatRoute and BeatStop records when BeatPlan is published</description>
    <environments>Default</environments>
    <interviewLabel>BeatPlan_Publish_RT {!$Flow.CurrentDateTime}</interviewLabel>
    <label>BeatPlan Publish RT</label>
    <processMetadataValues>
        <nameBuilderType>escalation</nameBuilderType>
        <processType>AutoLaunchedFlow</processType>
        <builderType>LightningFlowBuilder</builderType>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CreateBeatRoutes</targetReference>
        </connector>
        <object>BeatPlan__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Published</stringValue>
            </value>
        </filters>
    </start>
    <status>Active</status>
    <formulas>
        <description>Get current month start date</description>
        <name>CurrentMonthStart</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(TODAY()), MONTH(TODAY()), 1)</expression>
    </formulas>
    <actionCalls>
        <name>CreateBeatRoutes</name>
        <label>Create Beat Routes</label>
        <locationX>50</locationX>
        <locationY>100</locationY>
        <actionName>fastLookup</actionName>
        <actionType>fastLookup</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>Id</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <outputParameters>
            <assignToReference>$Record</assignToReference>
            <field>Id</field>
        </outputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <targetReference>BeatPlan__c</targetReference>
    </actionCalls>
</Flow>
